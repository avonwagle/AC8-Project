generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(255)
  assessments Assessment[]
}

model Assessment {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String
  objective   String
  duration    Int      // Duration in minutes
  categoryId  Int
 

  certificates Certificate[] // Add this line to link to Certificate

  // Relations
  category   Category     @relation(fields: [categoryId], references: [id])
  questions  Question[]
  QuizResult QuizResult[]
  userAnswers UserAnswer[] // Answers related to this assessment
}

model Question {
  id           Int          @id @default(autoincrement())
  text         String
  questionType QuestionType
  assessmentId Int // Foreign key to Assessment
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options      Option[] // Relation with Option model
  userAnswers  UserAnswer[] // Answers related to this question
}

model Option {
  id         Int      @id @default(autoincrement())
  text       String   @db.Text
  isCorrect  Boolean
  questionId Int // Foreign key to Question, non-nullable
  question   Question @relation(fields: [questionId], references: [id])
  userAnswers  UserAnswer[] // Answers related to this option
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model QuizResult {
  id           Int      @id @default(autoincrement())
  userId       String   // User who took the quiz
  assessmentId Int      // The assessment or quiz taken
  score        Float    // Score or result of the quiz
  passed       Boolean  // Whether the quiz was passed or not
  createdAt    DateTime @default(now()) // When the result was recorded

  user         User     @relation("QuizResultUser", fields: [userId], references: [id])
  assessment   Assessment   @relation(fields: [assessmentId], references: [id])
  certificate  Certificate?

  @@unique([userId, assessmentId]) 
}

model Certificate {
  id           Int      @id @default(autoincrement())
  userId       String   // User who receives the certificate
  assessmentId Int      // The assessment the certificate is for
  resultId     Int      // Foreign key: Link to the quiz result
  url          String   // URL or path to the generated certificate
  issuedAt     DateTime @default(now()) // When the certificate was issued

  user         User     @relation("CertificateUser", fields: [userId], references: [id], onDelete: Cascade)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  quizResult   QuizResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId])
}

model UserAnswer {
  id                Int        @id @default(autoincrement())
  userId            String     // User who answered the question
  assessmentId      Int        // Assessment ID
  questionId        Int        // Question ID
  selectedOptionId  Int?       // Option selected by the user
  shortAnswerText   String?    // Text answer for short-answer questions
  isCorrect         Boolean     // Whether the answer was correct

  user              User       @relation(fields: [userId], references: [id])
  assessment        Assessment @relation(fields: [assessmentId], references: [id])
  question          Question   @relation(fields: [questionId], references: [id])
  option            Option?    @relation(fields: [selectedOptionId], references: [id])

  @@unique([userId, assessmentId, questionId])
}

model User {
  id                    String      @id
  name                  String
  email                 String?     @unique
  aboutMe               String?
  linkedInProfileLink   String?
  profilePictureURL     String?
  profileBackgroundURL  String?
  isMentor              Boolean     @default(false)
  isMentee              Boolean     @default(false)
  availability          String?     // Text-based availability (could be parsed JSON or string)
  country               String?     // Country code (e.g., 'us', 'ca', etc.)
  specialization        String?     // Mentor's specialization or title
  rating                Float?      // Average rating of the mentor
  role                  String      @default("USER")
  overallRating         Float       @default(0)
  price                 Float       @default(0)
  
  mentorAreas           String[]    // Areas of mentorship expertise, directly as an array
  menteeInterests       String[]    // Mentee interests, directly as an array
  education             Education[] // Changed from String[] to Education[]
  experience            Experience[] // Changed from String[] to Experience[]
  skills                Skill[]     // Changed from String[] to Skill[]

  milestones            Milestone[]
  developmentAreas      DevelopmentArea[]
  badges                Badge[]

  // Relations
  mentorFor             MentorMentee[]  @relation(name: "MentorRelation")
  menteeFor             MentorMentee[]  @relation(name: "MenteeRelation")
  mentorRequests        MentorshipRequest[] @relation("MentorRequests")
  menteeRequests        MentorshipRequest[] @relation("MenteeRequests")
  sentMessages          Message[]       @relation("SentMessages")
  participatedChats     ChatParticipant[]
  reviews               Review[]        @relation("ReviewAuthor")
  reviewedMentors       Review[]        @relation("ReviewedMentor")
  videos                Video[]         // Mentor's videos
  appointmentsAsMentor  Appointment[]   @relation("MentorAppointments")
  appointmentsAsMentee  Appointment[]   @relation("MenteeAppointments")
  certificates Certificate[] @relation("CertificateUser")
  quizResults  QuizResult[]  @relation("QuizResultUser") 
  userAnswers           UserAnswer[]      // Answers given by this user
  successStories        SuccessStory[]  // Relations for Success Stories

  // Timestamps
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt @default(now())
}

model SuccessStory {
  id         Int      @id @default(autoincrement())    // Unique ID for each success story
  mentor     User     @relation(fields: [mentorId], references: [id]) // Foreign key to User table
  mentorId   String   // Mentor's ID from the User table
  title      String   // Title of the success story
  content    String   // Full content of the success story
  isApproved Boolean? // Nullable Admin approval status, implicitly null by default
  createdAt  DateTime @default(now())   // When the story was submitted
  updatedAt  DateTime @updatedAt        // When the story was last updated
}

model Review {
  id        Int      @id @default(autoincrement())
  content   String
  rating    Float    // Rating out of 5
  userId    String   // The user who wrote the review
  mentorId  String   // The mentor receiving the review
  createdAt DateTime @default(now())
  user      User     @relation("ReviewAuthor", fields: [userId], references: [id])
  mentor    User     @relation("ReviewedMentor", fields: [mentorId], references: [id])
}

model Video {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  embeddingLink String
  videoLength   String
  mentorId      String
  mentor        User     @relation(fields: [mentorId], references: [id])
}

model Appointment {
  id          Int      @id @default(autoincrement())
  date        DateTime
  status      AppointmentStatus @default(PENDING)
  mentorId    String
  menteeId    String
  mentor      User     @relation("MentorAppointments", fields: [mentorId], references: [id])
  mentee      User     @relation("MenteeAppointments", fields: [menteeId], references: [id])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
}

model Milestone {
  id        Int             @id @default(autoincrement())
  userId    String
  title     String
  status    MilestoneStatus
  startDate DateTime
  endDate   DateTime
  user      User            @relation(fields: [userId], references: [id])
  steps     MilestoneStep[]
}

model MilestoneStep {
  id          Int             @id @default(autoincrement())
  milestoneId Int
  name        String
  status      MilestoneStatus
  milestone   Milestone       @relation(fields: [milestoneId], references: [id])
}

model Badge {
  id           Int      @id @default(autoincrement())
  userId       String
  name         String
  icon         String
  senderName   String
  receivedDate DateTime
  message      String
  user         User     @relation(fields: [userId], references: [id])
}

model GetInTouch {
  id           Int       @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String
  demo         Boolean
  feedback     Boolean
  question     Boolean
  message      String
  receivedDate DateTime?
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Chat {
  id            Int               @id @default(autoincrement())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  participants  ChatParticipant[]
  messages      Message[]
}

model ChatParticipant {
  chatId    Int
  userId    String
  joinedAt  DateTime @default(now())

  chat      Chat     @relation(fields: [chatId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([chatId, userId])
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  chatId    Int
  senderId  String

  chat      Chat     @relation(fields: [chatId], references: [id])
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
}

model MentorshipRequest {
  id        Int      @id @default(autoincrement())
  mentorId  String
  menteeId  String
  status    MentorshipRequestStatus
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mentor    User     @relation("MentorRequests", fields: [mentorId], references: [id])
  mentee    User     @relation("MenteeRequests", fields: [menteeId], references: [id])

  @@unique([mentorId, menteeId])
}

enum MentorshipRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model MentorMentee {
  mentorId  String
  menteeId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentee User @relation(name: "MenteeRelation", fields: [menteeId], references: [id])
  mentor User @relation(name: "MentorRelation", fields: [mentorId], references: [id])

  @@id([mentorId, menteeId])
  @@unique([mentorId, menteeId])
}

model Education {
  id           Int       @id @default(autoincrement())
  userId       String
  institution  String
  degree       String
  fieldOfStudy String
  startDate    DateTime
  endDate      DateTime?
  grade        String?
  onGoing      Boolean
  user         User      @relation(fields: [userId], references: [id])
}

model Experience {
  id        Int       @id @default(autoincrement())
  userId    String
  position  String
  company   String
  location  String
  startDate DateTime
  endDate   DateTime?
  current   Boolean
  user      User      @relation(fields: [userId], references: [id])
}

model Skill {
  id     Int    @id @default(autoincrement())
  userId String
  name   String
  user   User   @relation(fields: [userId], references: [id])
}

model DevelopmentArea {
  id     Int    @id @default(autoincrement())
  userId String
  name   String
  user   User   @relation(fields: [userId], references: [id])
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  date      DateTime
  author    String
  imagePath String
}

model MediaRelease {
  id            Int    @id @default(autoincrement())
  title         String
  description   String
  imagePath     String
  href          String
}

model MentorFeedback {
  id           Int       @id @default(autoincrement())
  mentorId     String
  menteeId     String
  rating       Int
  feedback     String
  receivedDate DateTime  @default(now())
}

model Theme {
  id              Int      @id @default(autoincrement())
  organizationId  Int      // The organization or tenant that owns this theme
  logoUrl         String
  backgroundColor String
  textColor       String
  organization    Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Discussion {
  id        Int       @id @default(autoincrement())
  title     String
  comments  Comment[] // One-to-many relation with comments
  createdAt DateTime  @default(now())
}

model Comment {
  id           Int       @id @default(autoincrement())
  content      String
  discussion   Discussion @relation(fields: [discussionId], references: [id])
  discussionId Int
  createdAt    DateTime  @default(now())
}

model Organization {
  id             Int               @id @default(autoincrement())
  organizationname  String         @unique
  domain         String           @unique
  subdomain      String?          @unique
  databasename   String?
  contactemail   String?
  databaseurl    String
  isactive       Boolean          @default(true)
  createdat      DateTime         @default(now())
  updatedat      DateTime         @updatedAt
  

   // Relations
  logs              OrganizationLog[]
  themes            Theme[]
  featureFlags      FeatureFlag[] // Add this line to connect FeatureFlags to the organization
}


model FeatureFlag {
  id             Int          @id @default(autoincrement())
  organizationId Int
  featureName    String
  isEnabled      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Hashed password
  role      String   @default("editor") // Can be "SUPER_ADMIN", "ADMIN", etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs      OrganizationLog[]  // Relation to OrganizationLog
}

model OrganizationLog {
  id            Int       @id @default(autoincrement())
  organizationId    Int       // Foreign key field, referencing the Organization
  performedBy       Int       // Foreign key field, referencing the AdminUser who performed the action

  action      String    // e.g., "CREATED", "UPDATED", "DELETED", "DEACTIVATED"
  createdAt   DateTime  @default(now())

  organization      Organization    @relation(fields: [organizationId], references: [id])  // Relation to Organization model
  adminUser         AdminUser       @relation(fields: [performedBy], references: [id])      // Relation to AdminUser model
}


model Inquiry {
  id      Int      @id @default(autoincrement())
  user    String
  text    String
  responses Response[] // One-to-many relationship with responses
}
 
model Response {
  id         Int      @id @default(autoincrement())
  user       String
  text       String
  inquiry    Inquiry @relation(fields: [inquiryId], references: [id])
  inquiryId  Int
}
model Group {
  id          String         @id @default(uuid())
  name        String
  description String?
  participants GroupParticipant[]
  messages    GroupMessage[]
}
 
model GroupParticipant {
  id      String     @id @default(uuid())
  userId  String
  groupId String
  role    String     // e.g., 'admin', 'member'
  Group   Group      @relation(fields: [groupId], references: [id])
}
 
model GroupMessage {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  senderId  String
  groupId   String
  Group     Group    @relation(fields: [groupId], references: [id])
}